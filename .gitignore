node_modules/
# ...including a symlinked one: a worktree usually borrows the main checkout's
# node_modules, and a symlink is a FILE to git, which the trailing slash misses.
node_modules
dist/
.env
# In case a local copy of the host-side key file is ever dropped in-repo for
# testing (its real home is ~/.stack/env or ~/.ccm_config, never here).
/env
/.ccm_config
*.log
.DS_Store
*.tsbuildinfo
__pycache__/
# scripts/playwright's own run artefacts (#291) — screenshots + report.json
scripts/playwright/screenshots/
scripts/playwright/report.json

# design-sync (/design-sync): ds-bundle/ is the GENERATED upload — rebuilt from
# web/src/styles.css in two commands, so it is an artefact, not source. What IS
# source lives in .design-sync/ and is committed: the generators, the gate, the
# conventions header the design agent reads, and the notes.
ds-bundle/
.design-sync/.shots/
.design-sync/.verify.json
